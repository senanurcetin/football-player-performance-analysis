		annotation SummarizationSetBy = Automatic

	column birth_date
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: birth_date

		variation Variation
			isDefault
			relationship: c7b2052c-d1d6-4efa-a8f3-749a4155939b
