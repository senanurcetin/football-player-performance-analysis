		annotation SummarizationSetBy = Automatic

	column player_profile_completeness_pct
		dataType: double
		summarizeBy: sum
		sourceColumn: player_profile_completeness_pct

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column player_name_display
		dataType: string
		summarizeBy: none
