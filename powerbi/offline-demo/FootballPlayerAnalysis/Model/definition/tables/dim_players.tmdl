		annotation SummarizationSetBy = Automatic

	column preferred_foot
		dataType: string
		summarizeBy: none
		sourceColumn: preferred_foot

		annotation SummarizationSetBy = Automatic

	column agent_name
		dataType: string
		summarizeBy: none
		sourceColumn: agent_name

		annotation SummarizationSetBy = Automatic

	column current_club_id
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: current_club_id

		annotation SummarizationSetBy = Automatic

	column current_club_name
		dataType: string
		summarizeBy: none
