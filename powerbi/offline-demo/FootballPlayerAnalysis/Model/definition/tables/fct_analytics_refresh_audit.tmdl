table fct_analytics_refresh_audit

	measure 'Last Warehouse Audit Label' =
			VAR LatestAuditUtc = MAX ( fct_analytics_refresh_audit[audit_generated_at_utc] )
			VAR AuditAgeDays = DATEDIFF ( LatestAuditUtc, UTCNOW (), DAY )
			RETURN
			    IF (
			        ISBLANK ( LatestAuditUtc ),
			        "AUDIT / NOT AVAILABLE",
			        IF (
			            AuditAgeDays > 90,
			            "HISTORICAL / ",
			            "QUALITY AUDIT / "
			        ) & UPPER ( FORMAT ( LatestAuditUtc, "dd MMM yyyy", "en-US" ) )
			    )

	column audit_key
		dataType: string
		summarizeBy: none
		sourceColumn: audit_key

		annotation SummarizationSetBy = Automatic

	column audit_generated_at_utc
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: audit_generated_at_utc

		variation Variation
			isDefault
			relationship: 65faa3e4-1c52-401b-9425-a120bfb087ef
			defaultHierarchy: LocalDateTable_9aad1ec0-b250-48f2-ba51-b24ede5f4327.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

