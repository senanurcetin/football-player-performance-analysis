table fct_transfer_fixed_horizon_outcomes
	lineageTag: b1fd5ea3-a326-4332-9d08-496ae6fef9e2

	measure 'Eligible Transfers (365d)' =
			VAR SourceCutoff =
			    MIN(
			        TODAY(),
			        MAX(fct_transfer_fixed_horizon_outcomes[source_latest_valuation_date])
			    )
			RETURN
			    IF(
			        ISBLANK(SourceCutoff),
			        BLANK(),
			        CALCULATE(
			            DISTINCTCOUNT(fct_transfer_fixed_horizon_outcomes[transfer_key]),
			            FILTER(
			                fct_transfer_fixed_horizon_outcomes,
			                NOT ISBLANK(fct_transfer_fixed_horizon_outcomes[target_365d_date])
			                    && fct_transfer_fixed_horizon_outcomes[target_365d_date] + 30 <= SourceCutoff
			            )
			        )
			    )
		formatString: 0
		lineageTag: 70aa0385-bb9d-4d8d-9642-bf3715108bb5

	measure 'Observed Transfers (365d)' =
			VAR SourceCutoff =
			    MIN(
			        TODAY(),
			        MAX(fct_transfer_fixed_horizon_outcomes[source_latest_valuation_date])
			    )
			RETURN
			    IF(
			        ISBLANK(SourceCutoff),
			        BLANK(),
			        CALCULATE(
			            DISTINCTCOUNT(fct_transfer_fixed_horizon_outcomes[transfer_key]),
			            FILTER(
			                fct_transfer_fixed_horizon_outcomes,
			                NOT ISBLANK(fct_transfer_fixed_horizon_outcomes[target_365d_date])
			                    && fct_transfer_fixed_horizon_outcomes[target_365d_date] + 30 <= SourceCutoff
			                    && fct_transfer_fixed_horizon_outcomes[has_365d_outcome] = TRUE()
			            )
			        )
			    )
		formatString: 0
		lineageTag: 272af79c-d88e-4164-9dac-ddfde44e7a37

	measure 'Outcome Coverage (365d)' =
			DIVIDE(
			    [Observed Transfers (365d)],
			    [Eligible Transfers (365d)]
			)
		formatString: 0.0%
		lineageTag: 0d1c6c25-9891-4d83-91ff-1217f8159b8f

	measure 'Reliability Notice (365d)' =
			VAR Eligible = [Eligible Transfers (365d)]
			VAR Observed = [Observed Transfers (365d)]
			VAR Coverage = [Outcome Coverage (365d)]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Eligible) || Eligible = 0, "NO MATURED COHORT",
			        ISBLANK(Observed) || Observed < 30, "SMALL OBSERVED SAMPLE",
			        ISBLANK(Coverage) || Coverage < 0.8, "LOW FOLLOW-UP COVERAGE",
			        "OBSERVATIONAL ONLY"
			    )
		lineageTag: 66c99f78-c4a1-49e0-a1c0-1d6e1e212db7

	measure 'Transfers by Outcome Status (365d)' = DISTINCTCOUNT(fct_transfer_fixed_horizon_outcomes[transfer_key])
		formatString: 0
		lineageTag: 5bf0c7ea-f592-4669-8a85-7442c172f0b3

