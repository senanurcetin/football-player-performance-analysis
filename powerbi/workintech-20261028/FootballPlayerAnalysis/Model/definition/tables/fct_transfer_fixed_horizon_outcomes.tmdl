				    #"workintech-working" = Source{[Name="workintech-working"]}[Data],
				    football_mart_Schema = #"workintech-working"{[Name="nexus_football_mart",Kind="Schema"]}[Data],
				    fct_transfer_fixed_horizon_outcomes_Table = football_mart_Schema{[Name="fct_transfer_fixed_horizon_outcomes",Kind="Table"]}[Data]
				in
