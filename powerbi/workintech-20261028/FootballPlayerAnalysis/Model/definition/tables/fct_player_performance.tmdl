table fct_player_performance
	lineageTag: ed76a0fd-562c-40a7-9d63-82e5777f7d62

	measure 'Total Goals' = SUM(fct_player_performance[total_goals])
		formatString: 0
		lineageTag: cffc1c43-15b1-4f5b-b067-fdc7afb3fe0d

	measure 'Total Assists' = SUM(fct_player_performance[total_assists])
		formatString: 0
		lineageTag: d182585b-e466-4920-a54b-b6718d4e2f4c

	measure 'Total Minutes' = SUM(fct_player_performance[total_minutes_played])
		formatString: 0
		lineageTag: 40e436be-7e35-4330-8f58-b5b58861edbb

	measure 'Total Players Count' = DISTINCTCOUNT(fct_player_performance[player_id])
		formatString: 0
		lineageTag: f9d5f9ff-ad1a-4031-aeaa-e4efc608f147

	measure 'Player G+A per 90' =
			DIVIDE(
			    [Total Goals] + [Total Assists],
			    [Total Minutes],
			    BLANK()
			) * 90
		lineageTag: 959a3360-650e-4dba-aa68-6ff358e0231a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg G+A per 90' =
			
			AVERAGEX(
			    fct_player_performance,
			    fct_player_performance[goals_per_90] + fct_player_performance[assists_per_90]
			)
		lineageTag: a3a6b05c-498a-4cbd-a55b-97b81f495615

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Minutes' =
			
			AVERAGE(fct_player_performance[avg_minutes_per_match])
		lineageTag: cfa566dd-2fc9-4f27-9a34-cd4765b5085a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

