table fct_transfer_success_labels
	lineageTag: 0136047f-b78c-4425-9c0d-8cf1f773c128

	measure 'Transfers (365d)' =
			CALCULATE(
			    DISTINCTCOUNT(fct_transfer_success_labels[transfer_key]),
			    fct_transfer_success_labels[label_horizon_days] = 365
			)
		formatString: 0
		lineageTag: 2bc98524-71db-4200-b7e4-9437ac2a07f3

	measure 'Average Transfer Fee (365d)' =
			CALCULATE(
			    AVERAGE(fct_transfer_success_labels[transfer_fee]),
			    fct_transfer_success_labels[label_horizon_days] = 365
			)
		formatString: #,0
		lineageTag: aaec3a31-3151-4608-8549-6f92dde49d41

	measure 'Transfer Success Rate (365d)' =
			CALCULATE(
			    AVERAGE(fct_transfer_success_labels[is_successful_transfer]),
			    fct_transfer_success_labels[label_horizon_days] = 365
			)
		formatString: 0.0%
		lineageTag: ba413920-5333-45c3-aa05-252b8487646f

