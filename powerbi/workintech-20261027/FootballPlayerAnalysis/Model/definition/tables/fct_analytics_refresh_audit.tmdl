table fct_analytics_refresh_audit
	lineageTag: d22a5f40-db19-4e14-8a3f-fd2f69b30e84

	measure 'Last Warehouse Audit Label' =
			VAR LatestAuditUtc = MAX ( fct_analytics_refresh_audit[audit_generated_at_utc] )
			VAR AuditAgeDays = DATEDIFF ( LatestAuditUtc, UTCNOW (), DAY )
			RETURN
			    IF (
			        ISBLANK ( LatestAuditUtc ),
			        "AUDIT / NOT AVAILABLE",
			        IF (
			            AuditAgeDays > 90,
			            "HISTORICAL / ",
			            "QUALITY AUDIT / "
			        ) & UPPER ( FORMAT ( LatestAuditUtc, "dd MMM yyyy", "en-US" ) )
			    )
		lineageTag: 28eebc78-691c-402f-9a35-c31ba491c0ca

